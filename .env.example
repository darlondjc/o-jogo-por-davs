# Credenciais do Firestore (server-side apenas — nunca no Angular).
# Quando definidas, o Firestore vira o repositório ativo durante o jogo
# inteiro (mais rápido que o Sheets) — ver seção "Configurando o Firebase"
# do README. Sem elas, a API cai para o Google Sheets (se configurado) ou
# para o repositório em memória.

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Credenciais do Google Sheets (server-side apenas — nunca no Angular).
# Se estas três variáveis não estiverem definidas (e o Firestore acima
# também não estiver), a API usa automaticamente um repositório em memória
# com dados de demonstração (modo local/demo). Com o Firestore configurado,
# o Sheets vira só backup: recebe uma cópia do jogo quando ele finaliza.

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Login (ver seção "Login" do README). Sem GOOGLE_CLIENT_ID o botão "Entrar
# com Google" some do front-end. Sem SESSION_SECRET, um segredo temporário é
# gerado em memória a cada cold start — ok em dev, defina em produção.
GOOGLE_CLIENT_ID=
SESSION_SECRET=
