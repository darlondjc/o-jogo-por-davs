# Este projeto é buildado na Vercel, que não tem acesso ao Nexus interno do
# TRT (portal.pje.redejt) configurado no ~/.npmrc global desta máquina.
# Forçar o registry público aqui garante que `package-lock.json` seja
# gerado/instalado com URLs em registry.npmjs.org, alcançáveis pelo build
# remoto — sem alterar a config global usada pelos outros projetos.
registry=https://registry.npmjs.org/

# Retries mais tolerantes ajudam em redes instáveis durante o build remoto.
fetch-retries=3
fetch-retry-mintimeout=15000
fetch-retry-maxtimeout=45000

audit=false
fund=false
