# Mitiga um bug conhecido do npm ("Exit handler never called!") que aparece
# em ambientes de build com conexões instáveis/limitadas ao registry —
# reproduzido nos builds da Vercel deste projeto (dependência `googleapis`
# é grande). Retries mais tolerantes evitam o crash do processo do npm.
fetch-retries=3
fetch-retry-mintimeout=15000
fetch-retry-maxtimeout=45000
