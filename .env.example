# Credenciais do Google Sheets (server-side apenas — nunca no Angular).
# Se estas três variáveis não estiverem definidas, a API usa automaticamente
# um repositório em memória com dados de demonstração (modo local/demo).

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Login (ver seção "Login" do README). Sem GOOGLE_CLIENT_ID o botão "Entrar
# com Google" some do front-end. Sem SESSION_SECRET, um segredo temporário é
# gerado em memória a cada cold start — ok em dev, defina em produção.
GOOGLE_CLIENT_ID=
SESSION_SECRET=
