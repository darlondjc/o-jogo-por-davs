{
  "name": "o-jogo",
  "version": "0.0.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "smoke": "tsx scripts/smoke-test.ts",
    "dev:api": "tsx --env-file=.env scripts/dev-api-server.ts",
    "setup:sheets": "tsx --env-file=.env scripts/setup-sheets.ts",
    "verify:sheets": "tsx --env-file=.env scripts/verify-sheets.ts",
    "vercel-dev": "vercel dev"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@types/qrcode": "^1.5.6",
    "firebase-admin": "^14.2.0",
    "google-auth-library": "^10.5.0",
    "googleapis": "^174.0.1",
    "ngx-progressbar": "^14.0.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.4.3",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.32",
    "@angular/cli": "^20.3.32",
    "@angular/compiler-cli": "^20.3.0",
    "@types/jasmine": "~5.1.0",
    "@vercel/node": "^5.9.9",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "tsx": "^4.23.12",
    "typescript": "~5.9.2",
    "vercel": "^58.9.2"
  }
}
